# Database configurations
DB_HOST=localhost
DB_PORT=5432
DB_USER=odoo_user
DB_PASS=letmein1!
DB_NAME=New_Neet_Predictor

# Email configurations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS= 

# AI API configurations
AI_API_TO_USE=perplexity
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# WATI WhatsApp API Configuration
WATI_API_ENDPOINT=https://live-mt-server.wati.io/10208179
WATI_BEARER_TOKEN=
WATI_TEMPLATE_NAME=counselling_kit_message_to_student

# FTP credentials to store the counselling kit files
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=
FTP_PUBLIC_URL_PREFIX=

# To which admin email address(es) should be included in the CC - to every emails
ADMIN_EMAIL=

# Google Tag Manager ID
GTM_ID=

# Google Analytics ID
GOOGLE_ANALYTICS_ID=

# Microsoft Clarity ID
MS_CLARITY_ID=

# Zoho CRM configuration
ZOHO_CRM_ENABLED=true
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
# Long-lived refresh token. Generate ONCE by hand and paste the result here — the app
# never exchanges a grant token itself, because Zoho revokes the tokens issued from an
# authorization code as soon as that code is submitted a second time:
#   curl -X POST "https://accounts.zoho.com/oauth/v2/token" \
#     -d "grant_type=authorization_code" -d "code=<grant token from the API console>" \
#     -d "client_id=<id>" -d "client_secret=<secret>"
# Refresh tokens do not expire. Give each environment its own.
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_LEAD_SOURCE=Karnataka AI NEET Predictor
# Change both to the .in / .eu / etc. domains if the Zoho account is not on the US DC
ZOHO_CRM_ACCOUNTS_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_CRM_API_BASE_URL=https://www.zohoapis.com/crm/v8

# Firebase Realtime Database - caches the Zoho access token (not the refresh token)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_SECRET=
# Must differ per environment — dev, preview and production sharing one path means they
# overwrite each other's cached token. Note that Vercel Preview runs with
# NODE_ENV=production, so it uses Firebase rather than the local-file dev store.
FIREBASE_ZOHO_TOKEN_PATH=api_tokens/zoho-crm

# ---------------------------------------------------------------------------
# Lead recovery scripts (scripts/*) — local one-off use only.
# The app itself never reads these; do NOT add them to Vercel.
#
#   python3 scripts/fetch-lead-emails.py --since YYYY-MM-DD --out ./exported-emails
#   node scripts/parse-lead-emails.mjs ./exported-emails > recovered-leads.csv
#   node scripts/import-leads-to-zoho.mjs recovered-leads.csv [--commit]
#
# The importer reuses ZOHO_CRM_CLIENT_ID / ZOHO_CRM_CLIENT_SECRET /
# ZOHO_CRM_REFRESH_TOKEN / ZOHO_CRM_ACCOUNTS_URL / ZOHO_CRM_API_BASE_URL above.
# ---------------------------------------------------------------------------

# Mailbox holding the admin lead notifications. IMAP_USER/IMAP_PASS default to
# SMTP_USER/SMTP_PASS, because Gmail accepts the same App Password for both — set
# them explicitly only when the admin mailbox differs from the sending account.
# Gmail rejects a normal account password: generate an App Password and enable IMAP.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
# Use e.g. "[Gmail]/All Mail" if the notifications are filtered out of the inbox.
IMAP_FOLDER=INBOX

# Written to the Form_Name field of every backfilled lead, so recovered records stay
# identifiable in the CRM and can be told apart from live submissions.
RECOVERY_FORM_NAME=Email Recovery